# Replit run config for the Litmus marketing site (static Vite build).
run = "npm install && npm run build && npm run preview"
entrypoint = "src/App.jsx"

# Build once, then serve the static dist/ folder.
[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "npm install && npm run build"]
publicDir = "dist"

[[ports]]
localPort = 5190
externalPort = 80

[nix]
channel = "stable-24_05"
